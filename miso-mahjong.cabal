cabal-version:          3.0
name:                   miso-mahjong
version:                0.1.0.0
synopsis:               Riichi-style Mahjong, one player vs. CPU, built with miso
license:                BSD-3-Clause
author:                 dmjio
maintainer:             code@dmj.io
category:               Game
build-type:             Simple

executable app
  if arch(wasm32)
    cpp-options:
      -DWASM
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"

  hs-source-dirs:       src
  main-is:              Main.hs
  other-modules:        Model
                        Logic
                        TileView
                        Sound
                        Styles
  build-depends:        base, containers, miso, mtl
  ghc-options:          -Wall
  default-language:     GHC2021
  default-extensions:   CPP
                        LambdaCase
                        MultiWayIf
                        OverloadedStrings
                        QuasiQuotes
                        RecordWildCards
                        TupleSections
                        ViewPatterns
